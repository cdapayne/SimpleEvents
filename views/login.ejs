<script nonce="<%= cspNonce %>">
// D3 animated bar and line chart background
document.addEventListener('DOMContentLoaded', function() {
  const svg = d3.select('#d3-bg');
  function resize() {
    const w = window.innerWidth, h = window.innerHeight;
    svg.attr('width', w).attr('height', h);
  }
  resize();
  window.addEventListener('resize', resize);

  // Bar chart data
  const barCount = 12;
  let bars = Array.from({length: barCount}, (_, i) => ({
    x: i,
    height: Math.random()
  }));

  // Line chart data
  const lineCount = 24;
  let lineData = Array.from({length: lineCount}, (_, i) => ({
    x: i,
    y: Math.random()
  }));

  function animate() {
    const w = window.innerWidth, h = window.innerHeight;
    svg.selectAll('*').remove();

    // decorative defs: glow + line gradient
    const defs = svg.append('defs');
    defs.append('filter').attr('id','glow')
      .html('<feGaussianBlur stdDeviation="6" result="coloredBlur"/><feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge>');
    const lineGrad = defs.append('linearGradient').attr('id','lineGrad').attr('x1','0%').attr('x2','100%');
    const palette = ['#3b82f6','#6366f1','#38bdf8','#10b981','#f472b6','#f59e0b'];
    palette.forEach((c,i)=> lineGrad.append('stop').attr('offset', (i/(palette.length-1)*100)+'%').attr('stop-color', c).attr('stop-opacity', 0.85 - i*0.05));

    // Bar chart (lowered toward bottom)
    const barW = Math.max(18, w/barCount/2.8);
    svg.selectAll('rect')
      .data(bars)
      .enter()
      .append('rect')
      .attr('x', (d,i) => i * w/barCount + w/(barCount*1.8))
      .attr('y', d => h*0.85 - d.height*h*0.15)
      .attr('width', barW)
      .attr('height', d => d.height*h*0.15)
      .attr('rx', barW/3)
      .attr('fill', (d,i) => {
        const c = palette[i % palette.length];
        return c.replace('#','rgba(' + parseInt(c.slice(1,3),16) + ',' + parseInt(c.slice(3,5),16) + ',' + parseInt(c.slice(5,7),16) + ',0.22)');
      })
      .attr('stroke', (d,i) => palette[i % palette.length])
      .attr('stroke-width', 2);

    // Line chart (lowered)
    const line = d3.line()
      .x((d,i) => i * w/(lineCount-1))
      .y(d => h*0.72 - d.y*h*0.12)
      .curve(d3.curveMonotoneX);
    svg.append('path')
      .datum(lineData)
      .attr('d', line)
      .attr('fill', 'none')
      .attr('stroke', 'url(#lineGrad)')
      .attr('stroke-width', 4)
      .attr('filter', 'url(#glow)')
      .attr('stroke-linecap','round');
  }

  function tick() {
    // speedFactor slows movement (3x slower means smaller deltas and less frequent updates)
    const speedFactor = 3;
    // Animate bars (smaller step)
    bars = bars.map(d => ({
      x: d.x,
      height: Math.max(0.12, Math.min(0.95, d.height + (Math.random()-0.5)*(0.08 / speedFactor)))
    }));
    // Animate line (smaller step)
    lineData = lineData.map((d,i) => ({
      x: d.x,
      y: Math.max(0.08, Math.min(0.95, d.y + (Math.random()-0.5)*(0.07 / speedFactor)))
    }));
    animate();
  }

  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const speedFactor = 3;
  const tickMs = Math.max(40, Math.round((1000/60) * speedFactor)); // ~50ms for 3x slower
  let intervalId = null;
  if (!reduce) {
    intervalId = setInterval(tick, tickMs);
  } else {
    // render a single static frame for reduced-motion
    tick();
  }
});
</script>
<section class="row justify-content-center" aria-labelledby="loginHeading">
  <div class="col-md-5">
    <h1 id="loginHeading" class="h3 mb-3">Login</h1>
    <style nonce="<%= cspNonce %>">
      /* Light mode specific contrast fixes for login form */
      body:not([data-theme="dark"]) #loginHeading { color:#1a1f29; }
      body:not([data-theme="dark"]) #loginHeading + form label.form-label { color:#1f2937; font-weight:500; }
      body:not([data-theme="dark"]) .text-muted { color:#4b5563 !important; }
      /* Ensure placeholder contrast by darkening input text color is already adequate via global token */
    </style>
      <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-danger" role="alert" id="formError"><span class="visually-hidden">Error: </span><%= error %></div>
      <% } %>
      <form method="POST" action="/login" novalidate aria-describedby="<% if (typeof error !== 'undefined') { %>formError<% } %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label" for="loginEmail">Email address</label>
          <input id="loginEmail" type="email" name="email" class="form-control" required autocomplete="email" 
            <% if (typeof error !== 'undefined') { %>aria-invalid="true" aria-describedby="formError"<% } %> />
        </div>
        <div class="mb-3">
          <label class="form-label" for="loginPassword">Password</label>
          <input id="loginPassword" type="password" name="password" class="form-control" required autocomplete="current-password" 
            <% if (typeof error !== 'undefined') { %>aria-invalid="true" aria-describedby="formError"<% } %> />
        </div>
        <button class="btn btn-primary w-100" type="submit">Login</button>
        <p class="text-muted small mt-3 mb-0 text-center">No account? <a href="/register">Register</a></p>
      </form>
    </div>
    <svg id="d3-bg" class="position-absolute top-0 start-0 w-100 h-100" style="z-index:0; pointer-events:none;" aria-hidden="true" role="presentation"></svg>
    <script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js" nonce="<%= cspNonce %>"></script>
  </section>
  </div>
</section>
<script nonce="<%= cspNonce %>">
  (function(){
    const err = document.getElementById('formError');
    if(err){
      err.setAttribute('tabindex','-1');
      err.focus();
    } else {
      const email = document.getElementById('loginEmail');
      if(email) email.focus();
    }
  })();
</script>
