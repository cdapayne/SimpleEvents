<section class="container-fluid py-5 bg-dark text-light">
  <div class="container py-4">
    <div class="row align-items-center mb-4">
      <div class="col-md-8">
        <h1 class="display-6 fw-bold mb-1">Plans & Pricing</h1>
        <p class="text-muted mb-0">Compare tiers, pick a plan, and upgrade anytime. This page is shown in dark mode to match the welcome experience.</p>
      </div>
      <div class="col-md-4 text-md-end">
        <% if (!sessionUser) { %>
          <a href="/register" class="btn btn-lg btn-primary">Start for free</a>
        <% } else { %>
          <a href="/billing#upgrade" class="btn btn-lg btn-outline-light">Manage plan</a>
        <% } %>
      </div>
    </div>

    <div class="row g-4">
      <% for(let i=0;i<(plans||[]).length;i++){ const p=plans[i]; const code=p.code; %>
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 bg-secondary-subtle text-light border-0 shadow-lg">
          <div class="card-body d-flex flex-column bg-dark border border-light border-3 rounded-3">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h3 class="h5 mb-1"><%= p.name %></h3>
                <p class="small text-muted mb-2"><%= p.code === 'TRIAL' ? 'Free' : '' %></p>
              </div>
              <div class="text-end">
                <% if (p.monthlyEventLimit === Infinity) { %>
                  <div class="h5 fw-bold">Unlimited</div>
                <% } else { %>
                  <div class="h4 fw-bold"><%= p.monthlyEventLimit.toLocaleString() %></div>
                  <div class="small text-muted">events / month</div>
                <% } %>
              </div>
            </div>
            <hr class="border-top border-light opacity-25">
            <ul class="list-unstyled mb-3 small">
              <li>Dashboards: <strong><%= isFinite(p.dashboardsLimit||0) ? p.dashboardsLimit : 'Unlimited' %></strong></li>
              <li>Saved charts: <strong><%= isFinite(p.chartsLimit||0) ? p.chartsLimit : 'Unlimited' %></strong></li>
              <li>Chart types: <strong><%= Array.isArray(p.includedChartTypes) ? (p.includedChartTypes.includes('*') ? 'All current & future' : p.includedChartTypes.join(', ')) : 'All' %></strong></li>
              <li>Branding: <strong><%= p.branding ? 'Included' : 'Not included' %></strong></li>
            </ul>
            <div class="mt-auto">
              <% if (!sessionUser) { %>
                <% if (p.code === 'TRIAL') { %>
                  <a href="/register" class="btn btn-primary w-100">Create Free Workspace</a>
                <% } else { %>
                  <form method="POST" action="/billing/upgrade">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="planCode" value="<%= code %>">
                    <button type="submit" class="btn btn-outline-light w-100">Sign up for <%= p.name %></button>
                  </form>
                <% } %>
              <% } else { %>
                <form method="POST" action="/billing/upgrade">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="planCode" value="<%= code %>">
                  <button type="submit" class="btn bg-dark <%= (plan && plan.code===p.code) ? 'btn-success' : 'btn-primary' %> w-100"><%= (plan && plan.code===p.code) ? 'Current plan' : (p.code==='TRIAL' ? 'Downgrade to Free' : 'Upgrade / Choose') %></button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <% } %>
    </div>

    <div class="mt-5">
      <h4 class="h6">Notes</h4>
      <p class="small text-muted">Tier 1 includes access to bar, line and pie charts. All other tiers include all current chart types and will receive new chart types in the future. Tier 3 additionally includes branding capability. All other tiers receive access to the rest of our capabilities.</p>
    </div>
  </div>
</section>
