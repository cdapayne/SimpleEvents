<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script nonce="<%= cspNonce %>">
(function(){
  const root = document.documentElement;
  root.setAttribute('data-theme','dark');
  try { localStorage.setItem('se_theme_v1','dark'); } catch (e) {}

  const palette = ['#60a5fa','#f472b6','#34d399','#fbbf24','#818cf8'];
  const ctx = document.getElementById('demoChart').getContext('2d');
  const datasetButtons = document.querySelectorAll('#demoSwitch button');
  const chartTypeButtons = document.querySelectorAll('[data-demo-chart]');
  const title = document.getElementById('demoTitle');
  const topEvent = document.getElementById('demoTopEvent');
  const growth = document.getElementById('demoGrowth');
  const spotlightLabel = document.getElementById('demoSpotlightLabel');
  const spotlightValue = document.getElementById('demoSpotlightValue');

  const datasets = {
    acquisition: {
      title: 'Acquisition Pulse',
      top: 'signup.started',
      growth: '+28%',
      spotlight: { label: 'Conversion rate', value: '4.7%' },
      trend: { labels: ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'], data: [45,62,58,74,89,105,122] },
      channels: { labels: ['Organic','Paid','Referral','Partners'], data: [42,31,18,9] }
    },
    activation: {
      title: 'Activation Health',
      top: 'workspace.created',
      growth: '+18%',
      spotlight: { label: 'Day-7 activation', value: '63%' },
      trend: { labels: ['Week 1','Week 2','Week 3','Week 4','Week 5'], data: [38,44,57,68,76] },
      channels: { labels: ['Guided onboarding','Self-serve','Invites'], data: [48,33,19] }
    },
    revenue: {
      title: 'Revenue Momentum',
      top: 'subscription.upgraded',
      growth: '+42%',
      spotlight: { label: 'MRR this week', value: '$48.2k' },
      trend: { labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul'], data: [21,26,33,38,46,54,63] },
      channels: { labels: ['Starter','Growth','Scale','Enterprise'], data: [28,32,21,19] }
    }
  };

  let activeDataset = 'acquisition';
  let activeChartType = 'line';
  let chart;

  function buildChartConfig(data, type) {
    if (type === 'doughnut') {
      const source = data.channels || data.trend;
      return {
        type: 'doughnut',
        data: {
          labels: source.labels,
          datasets: [{
            data: source.data,
            backgroundColor: source.labels.map((_, idx) => palette[idx % palette.length]),
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { color: '#e2e8f0' } }
          }
        }
      };
    }

    const baseType = type;
    const isLine = baseType === 'line';
    const isBar = baseType === 'bar';
    return {
      type: baseType,
      data: {
        labels: data.trend.labels,
        datasets: [{
          label: data.title,
          data: data.trend.data,
          fill: isLine,
          tension: 0.35,
          borderColor: 'rgba(96,165,250,0.95)',
          backgroundColor: isBar ? 'rgba(96,165,250,0.35)' : 'rgba(96,165,250,0.20)',
          borderWidth: 2,
          borderRadius: isBar ? 8 : 0,
          pointRadius: 3,
          pointHoverRadius: 5
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { mode: 'index', intersect: false }
        },
        scales: {
          x: {
            grid: { color: 'rgba(148,163,184,0.12)' },
            ticks: { color: '#cbd5f5' }
          },
          y: {
            beginAtZero: true,
            grid: { color: 'rgba(148,163,184,0.12)' },
            ticks: { color: '#cbd5f5' }
          }
        }
      }
    };
  }

  function setActiveState(buttons, attr, value) {
    buttons.forEach(btn => {
      if (btn.getAttribute(attr) === value) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });
  }

  function render() {
    const data = datasets[activeDataset] || datasets.acquisition;
    title.textContent = data.title;
    topEvent.textContent = data.top;
    growth.textContent = data.growth;
    if (data.spotlight) {
      spotlightLabel.textContent = data.spotlight.label;
      spotlightValue.textContent = data.spotlight.value;
    }
    const config = buildChartConfig(data, activeChartType);
    if (chart) chart.destroy();
    chart = new Chart(ctx, config);
  }

  datasetButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      activeDataset = btn.getAttribute('data-key') || activeDataset;
      setActiveState(datasetButtons, 'data-key', activeDataset);
      render();
    });
  });

  chartTypeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      activeChartType = btn.getAttribute('data-demo-chart') || activeChartType;
      setActiveState(chartTypeButtons, 'data-demo-chart', activeChartType);
      render();
    });
  });

  setActiveState(datasetButtons, 'data-key', activeDataset);
  setActiveState(chartTypeButtons, 'data-demo-chart', activeChartType);
  render();
})();
</script>
