<script nonce="<%= cspNonce %>">(function(){
  const root = document.documentElement;
  const key='se_theme_v1';
  function apply(t){ if(t==='dark'){ root.setAttribute('data-theme','dark'); btn.textContent='☀️'; } else { root.removeAttribute('data-theme'); btn.textContent='🌙'; } }
  const btn = document.getElementById('themeToggle');
  let current = localStorage.getItem(key) || 'light';
  apply(current);
  btn.addEventListener('click',()=>{ current = current==='dark'?'light':'dark'; localStorage.setItem(key,current); apply(current); });
})();</script>
