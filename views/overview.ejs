<div class="pb-3 border-bottom mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <div class="d-flex align-items-center gap-3">
    <h1 class="h3 mb-0">Overview</h1>
  </div>
  <div>
    <a class="btn btn-sm btn-outline-secondary" href="/">Back to Dashboard</a>
  </div>
</div>
<div id="overviewRow" class="row g-4">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title d-flex justify-content-between align-items-center">Getting Started <span class="badge bg-primary">New</span></h5>
        <ol class="small ps-3 mb-3" id="onboardSteps">
          <li data-step="key">Create an API Key <a href="/apikeys" class="ms-1">Open</a></li>
          <li data-step="event">Send a Test Event <button class="btn btn-link btn-sm p-0" data-bs-toggle="modal" data-bs-target="#testEventModal">Send</button></li>
          <li data-step="view">View Events <a href="/events" class="ms-1">Go</a></li>
          <li data-step="report">Build a Report <a href="/reports/new" class="ms-1">Build</a></li>
        </ol>
        <div class="alert alert-info small mb-0" id="onboardHint">Complete the steps above to finish setup.</div>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Events Tracked</h5>
        <p class="display-6 fw-semibold text-primary"><%= eventsCount %></p>
        <p class="text-muted small mb-0">Across <%= accountsCount %> account(s).</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Plan Usage</h5>
        <p class="mb-1 small text-muted"><%= plan.name %></p>
        <% if (isFinite(limit)) { %>
        <div class="progress mb-2" style="height: 16px;">
          <div class="progress-bar <%= nearLimit ? 'bg-danger' : 'bg-success' %>" role="progressbar" data-percent="<%= percent %>" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <p class="small mb-0"><%= usage.events %> / <%= limit.toLocaleString() %> events (<%= percent %>%)</p>
        <% } else { %>
        <p class="h5 mb-0">Unlimited</p>
        <% } %>
        <% if (nearLimit) { %>
        <div class="alert alert-warning mt-3 p-2 small mb-0">You're at <%= percent %>% of your event quota.</div>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Users</h5>
        <p class="display-6 fw-semibold text-primary"><%= usersCount %></p>
        <p class="text-muted small mb-0">Seed demo owner included.</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <h5 class="card-title">Last Ingest</h5>
        <p class="display-6 fw-semibold text-primary">Recent</p>
        <p class="text-muted small mb-0">Events generated on seed.</p>
      </div>
    </div>
  </div>
</div>

<!-- Include the shared test event modal so Send Test works on this page -->
<%- include('partials/_test_event_modal') %>
